{
  "$schema": "https://copilot.github.com/.copilot/settings.schema.json",
  "description": "AI agentic coding configuration for Angular 19+ frontend",
  "extends": "../CLAUDE.md",
  "language": "TypeScript",
  "framework": "Angular 19+",

  "languageServer": {
    "type": "TypeScript Language Server (tsserver)",
    "enabled": true,
    "diagnostics": {
      "enabled": true,
      "strictMode": true,
      "noImplicitAny": true
    }
  },

  "build": {
    "command": "pnpm --filter frontend run build",
    "description": "Angular production build via Vite/ng build",
    "watch": true
  },

  "test": {
    "command": "pnpm --filter frontend run test",
    "framework": "Vitest + Testing Library",
    "description": "Frontend unit tests (query by role, not implementation details)"
  },

  "codeGeneration": {
    "enabled": true,
    "command": "pnpm codegen",
    "trigger": "after backend schema changes (dotnet build → pnpm codegen)",
    "generatedFile": "src/app/api/generated/graphql.ts",
    "sourceFile": "../backend/src/FactoryApp.WebApi/schema.graphql"
  },

  "guardrails": {
    "graphql": {
      "rule": "Never manually edit graphql.ts — auto-generated by pnpm codegen",
      "action": "Regenerate after backend schema changes: dotnet build → pnpm codegen",
      "reference": "AGENTS.md, frontend-patterns.md"
    },
    "changeDetection": {
      "rule": "ChangeDetectionStrategy.OnPush mandatory on all components",
      "action": "Avoid dirty-check cycles; improves performance on large forms",
      "reference": "AGENTS.md, frontend-patterns.md"
    },
    "trackBy": {
      "rule": "Add trackBy function to every *ngFor loop",
      "pattern": "trackBy(index: number, item: T) => item.id",
      "action": "Prevents unnecessary DOM recreation; performance critical",
      "reference": "AGENTS.md, frontend-patterns.md"
    },
    "subscriptions": {
      "rule": "Buffer high-frequency subscriptions (>10/sec) with bufferTime(250)",
      "pattern": "subscription.pipe(bufferTime(250), filter(updates => updates.length > 0))",
      "action": "Aggregate updates; reduces render cycles",
      "reference": "frontend-patterns.md, graphql-patterns.md"
    },
    "queryDepth": {
      "rule": "GraphQL query depth: maximum 5 layers",
      "action": "Split deeper queries into separate requests; prevents N+1 queries",
      "reference": "graphql-patterns.md"
    },
    "types": {
      "rule": "Use generated types only (import from graphql.ts)",
      "action": "Never hand-roll type aliases; keeps frontend in sync with backend",
      "reference": "AGENTS.md, frontend-patterns.md"
    }
  },

  "documentation": {
    "rootClaude": "../CLAUDE.md",
    "rootDesign": "../DESIGN.md",
    "rules": {
      "frontend": "../.claude/rules/frontend-patterns.md",
      "graphql": "../.claude/rules/graphql-patterns.md"
    },
    "related": [
      "../AGENTS.md (Agent guardrails & setup commands)",
      "../docs/ARCHITECTURE.md (Type-safety pipeline)",
      "../docs/DEVELOPMENT.md (IDE setup & debugging)"
    ]
  },

  "commands": {
    "setup": "pnpm install && pnpm setup",
    "dev": "pnpm --filter frontend run ng serve",
    "codegen": "pnpm codegen",
    "lint": "pnpm lint",
    "test": "pnpm --filter frontend run test",
    "build": "pnpm --filter frontend run build"
  }
}
