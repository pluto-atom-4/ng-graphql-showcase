{
  "name": "frontend",
  "version": "1.0.0",
  "description": "Angular 19 frontend for manufacturing workflow management",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run --include='**/__tests__/accessibility/**/*.spec.ts' --include='**/__tests__/keyboard-navigation.spec.ts' --include='**/__tests__/aria-compliance.spec.ts'",
    "test:keyboard": "vitest run --include='**/__tests__/keyboard-navigation.spec.ts'",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "lint": "ng lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json,md}\"",
    "codegen": "pnpm graphql-code-generator --config codegen.ts",
    "audit:lighthouse": "lighthouse http://localhost:4200 --config-path=a11y/lighthouse.config.js --output=json --output-path=a11y/reports/baseline-lighthouse.json",
    "audit:pa11y": "pa11y-ci --config=a11y/pa11y-config.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@apollo/client": "^3.11.0",
    "apollo-angular": "^9.0.0",
    "graphql": "^16.8.0",
    "graphql-ws": "^6.0.8",
    "rxjs": "^7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.0",
    "@analogjs/vitest-angular": "^2.5.3",
    "@angular-devkit/build-angular": "^19.0.0",
    "@angular-eslint/builder": "^19.8.1",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular-eslint/schematics": "^19.8.1",
    "@angular-eslint/template-parser": "^19.8.1",
    "@angular/cli": "^19.0.0",
    "@angular/compiler-cli": "^19.0.0",
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-apollo-angular": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.9",
    "angular-eslint": "^22.0.0",
    "daisyui": "^5.0.0",
    "eslint": "^9.39.4",
    "happy-dom": "^20.10.6",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.8",
    "axe-core": "^4.9.0",
    "axe-playwright": "^1.2.3",
    "@axe-core/playwright": "^4.9.0",
    "pa11y": "^9.0.0",
    "pa11y-ci": "^3.1.0",
    "lighthouse": "^11.5.0",
    "playwright": "^1.48.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.5.2",
    "color-contrast-checker": "^2.0.1"
  }
}
