{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(dotnet *)",
      "Bash(pnpm *)",
      "Bash(pnpm codegen)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Read",
      "Glob",
      "Grep",
      "Edit(CLAUDE.md|AGENTS.md|SKILLS.md|.claude/**/*.md|.github/**/*.md|frontend/src/**/*|backend/src/**/*)",
      "WebFetch(domain:docs.elsaworkflows.io)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:angular.dev)",
      "WebFetch(domain:chillicream.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "Skill(codegen-sync)",
      "Skill(migration-generator)",
      "Skill(pr-review-workflow)",
      "Skill(performance-audit)",
      "Bash(code-review-graph status:*)",
      "Bash(code-review-graph update:*)",
      "Bash(code-review-graph query:*)",
      "Bash(code-review-graph impact:*)",
      "Bash(code-review-graph detect-changes:*)",
      "Bash(code-review-graph architecture:*)",
      "Bash(code-review-graph dead-code:*)",
      "Bash(code-review-graph large-functions:*)",
      "Bash(graphify update:*)",
      "Bash(graphify query:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify affected:*)",
      "Bash(graphify path:*)",
      "Bash(graphify god-nodes:*)",
      "mcp__code-review-graph__*",
      "mcp__graphify__*"
    ],
    "defaultMode": "default"
  },
  "model": "claude-opus-5",
  "effortLevel": "high",
  "skillOverrides": {
    "fix-github-issues": "on",
    "session-blog-to-gist": "on",
    "example-skills:doc-coauthoring": "on",
    "update-config": "on",
    "secure-github-repo": "on",
    "performance-audit": "on",
    "pre-commit-enforce": "on",
    "pr-review-workflow": "on"
  },
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/vendor/**/CLAUDE.md"
  ],
  "env": {
    "DOTNET_ENVIRONMENT": "Development",
    "ASPNETCORE_URLS": "http://localhost:5000",
    "NODE_ENV": "development",
    "DOCKER_BUILDKIT": "1",
    "MAX_THINKING_TOKENS": "4000",
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_TIMEOUT": "45"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); if echo \"$cmd\" | grep -qE 'sudo|rm -rf /|curl.*(password|secret|token)|git reset --hard|git push --force|git clean -fd'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"High-risk command blocked. Requires explicit override. Run with: ! <command>\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path'); case \"$fp\" in *schema.graphql|*graphql.ts) echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Auto-generated file. Regenerate via: dotnet build (backend) or pnpm codegen (frontend)\"}}';; esac"
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${GRAPHIFY_HOOK_DISABLED:-0}\" = \"1\" ] || .claude/hooks/graphify-interceptor.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); exit_code=$(jq -r '.tool_response.exitCode // \"0\"'); [ -n \"$cmd\" ] && echo \"$(date -Iseconds)|Bash|$cmd|allowed|$exit_code\" >> .claude/tool-invocations.log"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_response.filePath // .tool_input.file_path'); case \"$fp\" in *.ts|*.tsx) pnpm --filter frontend run lint -- --fix 2>/dev/null || true;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_response.filePath // .tool_input.file_path'); case \"$fp\" in *.md) prettier --write \"$fp\" 2>/dev/null || true;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_response.filePath // .tool_input.file_path'); case \"$fp\" in .claude/*|.github/*) echo \"$(date -Iseconds) Changed: $fp\" >> .claude/friction-log.md;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${GRAPH_HOOKS_DISABLED:-0}\" = \"1\" ] || { command -v code-review-graph >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph update --skip-flows >/dev/null 2>&1; } || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v code-review-graph >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1 && code-review-graph status 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
