{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(dotnet *)",
      "Bash(pnpm *)",
      "Bash(pnpm codegen)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Read",
      "Glob",
      "Grep",
      "Edit(CLAUDE.md|AGENTS.md|SKILLS.md|.claude/**/*.md|.github/**/*.md|frontend/src/**/*|backend/src/**/*)",
      "WebFetch(domain:docs.elsaworkflows.io)",
      "WebFetch(domain:api.github.com)",
      "Skill(codegen-sync)",
      "Skill(migration-generator)",
      "Skill(pr-review-workflow)",
      "Skill(performance-audit)"
    ],
    "defaultMode": "default"
  },
  "model": "claude-haiku-4-5-20251001",
  "effortLevel": "medium",
  "skillOverrides": {
    "fix-github-issues": "on",
    "session-blog-to-gist": "on",
    "example-skills:doc-coauthoring": "on",
    "update-config": "on",
    "secure-github-repo": "on"
  },
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": true,
  "claudeMdExcludes": [
    "**/node_modules/**/CLAUDE.md",
    "**/vendor/**/CLAUDE.md"
  ],
  "env": {
    "DOTNET_ENVIRONMENT": "Development",
    "ASPNETCORE_URLS": "http://localhost:5000",
    "NODE_ENV": "development",
    "DOCKER_BUILDKIT": "1",
    "MAX_THINKING_TOKENS": "auto",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium",
    "CLAUDE_CODE_TIMEOUT": "30"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command'); if echo \"$cmd\" | grep -qE 'sudo|rm -rf /|curl.*(password|secret|token)|git reset --hard|git push --force|git clean -fd'; then echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"High-risk command blocked. Requires explicit override. Run with: ! <command>\"}}'; fi"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path'); case \"$fp\" in *schema.graphql|*graphql.ts) echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Auto-generated file. Regenerate via: dotnet build (backend) or pnpm codegen (frontend)\"}}';; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(jq -r '.tool_input.command // \"\"'); exit_code=$(jq -r '.tool_response.exitCode // \"0\"'); [ -n \"$cmd\" ] && echo \"$(date -Iseconds)|Bash|$cmd|allowed|$exit_code\" >> .claude/tool-invocations.log"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_response.filePath // .tool_input.file_path'); case \"$fp\" in *.ts|*.tsx) pnpm --filter frontend run lint -- --fix 2>/dev/null || true;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_response.filePath // .tool_input.file_path'); case \"$fp\" in *.md) prettier --write \"$fp\" 2>/dev/null || true;; esac"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_response.filePath // .tool_input.file_path'); case \"$fp\" in .claude/*|.github/*) echo \"$(date -Iseconds) Changed: $fp\" >> .claude/friction-log.md;; esac"
          }
        ]
      }
    ]
  }
}
