#!/bin/bash
# Pre-commit Bundle Size Check
# Detects if bundle size increased >10% vs. baseline
# Fails pre-commit if threshold exceeded (allows override with --force-build-scripts)
#
# Usage: ./.claude/hooks/pre-commit-bundle-check
# Exit codes:
#   0 = Bundle OK (within threshold)
#   1 = Bundle exceeded threshold (commit blocked)
#   2 = Baseline not found (skip check, inform user)

set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
HOOKS_DIR="${REPO_ROOT}/.claude/hooks"
EVIDENCE_DIR="${REPO_ROOT}/.claude/evidence"
FRICTION_LOG="${REPO_ROOT}/.claude/friction-log.md"
BUILD_DIR="${REPO_ROOT}/frontend/dist"

# Thresholds
BUNDLE_THRESHOLD_PERCENT=10
BUNDLE_THRESHOLD_KB=20

# Color codes
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Logging functions
log_error() {
  echo -e "${RED}[BUNDLE CHECK] ERROR: $1${NC}" >&2
}

log_warn() {
  echo -e "${YELLOW}[BUNDLE CHECK] WARN: $1${NC}" >&2
}

log_info() {
  echo -e "${GREEN}[BUNDLE CHECK] INFO: $1${NC}"
}

log_debug() {
  if [ "${DEBUG}" = "1" ]; then
    echo "[BUNDLE CHECK] DEBUG: $1" >&2
  fi
}

# Helper: Extract gzipped bundle size from stats.json
get_bundle_size() {
  local stats_file="$1"
  if [ ! -f "$stats_file" ]; then
    return 1
  fi

  # Extract gzipped size from webpack stats
  # Assumes stats.json has .gzipped field or we calculate from assets
  if command -v jq &> /dev/null; then
    jq -r '.gzipped // .assets[0].gzipSize // 0' "$stats_file" 2>/dev/null || echo "0"
  else
    # Fallback: grep for gzipped size (if present in JSON)
    grep -o '"gzipped":[0-9]*' "$stats_file" 2>/dev/null | cut -d':' -f2 || echo "0"
  fi
}

# Helper: Check if override flag is set
has_override() {
  # Check for --force-build-scripts flag in git commit message or env
  if [ "${FORCE_BUILD_SCRIPTS}" = "1" ]; then
    return 0
  fi

  # Check if commit message will contain override
  # (Note: not available in pre-commit hook, but documented for user)
  return 1
}

# Helper: Log to friction log
log_friction() {
  local message="$1"
  local timestamp=$(date "+%Y-%m-%d %H:%M:%S")

  if [ -f "$FRICTION_LOG" ]; then
    echo "- \`${timestamp}\` - BUNDLE CHECK: ${message}" >> "$FRICTION_LOG"
  fi
}

# Main bundle check logic
main() {
  log_debug "Starting bundle size check..."

  # Skip if not a frontend build
  if [ ! -d "$BUILD_DIR" ]; then
    log_debug "Build directory not found ($BUILD_DIR), skipping bundle check"
    return 0
  fi

  # Ensure evidence directory exists
  mkdir -p "$EVIDENCE_DIR"

  # Get current bundle stats (build needs to be run first)
  local current_stats="${BUILD_DIR}/stats.json"

  if [ ! -f "$current_stats" ]; then
    log_warn "Bundle stats not found. Run 'pnpm build --stats' to generate stats."
    log_warn "Skipping bundle check (not blocking, but recommended)."
    return 0
  fi

  # Get baseline bundle size
  local baseline_file="${EVIDENCE_DIR}/.bundle-baseline.json"

  if [ ! -f "$baseline_file" ]; then
    log_info "First run detected. Creating baseline bundle size..."
    cp "$current_stats" "$baseline_file"
    log_info "Baseline saved to: $baseline_file"
    return 0
  fi

  # Parse bundle sizes
  local baseline_size=$(get_bundle_size "$baseline_file")
  local current_size=$(get_bundle_size "$current_stats")

  log_debug "Baseline: ${baseline_size} KB, Current: ${current_size} KB"

  # Handle parse errors
  if [ "$baseline_size" = "0" ] || [ "$current_size" = "0" ]; then
    log_warn "Could not parse bundle sizes from stats.json (might be in different format)"
    log_warn "Skipping bundle check."
    return 0
  fi

  # Calculate delta
  local delta=$((current_size - baseline_size))
  local delta_percent=$(awk "BEGIN {printf \"%.1f\", ($delta / $baseline_size) * 100}")

  log_debug "Delta: ${delta} KB (${delta_percent}%)"

  # Check against thresholds
  if [ "$delta" -gt "$BUNDLE_THRESHOLD_KB" ] || [ "${delta_percent%.*}" -gt "$BUNDLE_THRESHOLD_PERCENT" ]; then
    log_error "Bundle size increased by ${delta_percent}% (${delta} KB)"
    log_error "Threshold: ${BUNDLE_THRESHOLD_PERCENT}% (${BUNDLE_THRESHOLD_KB} KB)"
    echo ""
    echo "Bundle size regression detected:"
    echo "  Baseline:  ${baseline_size} KB"
    echo "  Current:   ${current_size} KB"
    echo "  Delta:     +${delta} KB (+${delta_percent}%)"
    echo ""
    echo "This may indicate:"
    echo "  - New dependencies added without tree-shaking"
    echo "  - Unused code not being removed"
    echo "  - Bundle analyzer misconfiguration"
    echo ""
    echo "Options:"
    echo "  1. Optimize bundle (remove unused deps, tree-shake)"
    echo "  2. Update baseline: rm $baseline_file && pnpm build --stats"
    echo "  3. Override (if acceptable): git commit -m \"...\" --env FORCE_BUILD_SCRIPTS=1"
    echo ""

    # Log to friction log
    log_friction "Bundle increased by ${delta_percent}% (+${delta}KB) — BLOCKED. Baseline: ${baseline_size}KB → Current: ${current_size}KB"

    return 1
  else
    if [ "$delta" -lt "0" ]; then
      log_info "Bundle size decreased by ${delta} KB (${delta_percent}%) ✅"
    else
      log_info "Bundle size stable (+${delta} KB, ${delta_percent}%) ✅"
    fi

    # Log minor changes
    if [ "$delta" -ne "0" ]; then
      log_friction "Bundle delta: +${delta}KB (+${delta_percent}%) — within threshold"
    fi

    return 0
  fi
}

# Run main
main "$@"
exit $?
