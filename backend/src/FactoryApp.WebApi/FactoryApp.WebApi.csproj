<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Generate schema.graphql on build -->
    <GenerateSchemaFile>true</GenerateSchemaFile>
    <SchemaFilePath>schema.graphql</SchemaFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Elsa" Version="3.7.1" />
    <PackageReference Include="Elsa.Persistence.Dapper" Version="3.7.1" />
    <PackageReference Include="Elsa.Persistence.Dapper.Migrations" Version="3.7.1" />
    <PackageReference Include="FluentMigrator.Runner" Version="7.2.0" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.5.0" />
    <PackageReference Include="HotChocolate.Authorization" Version="16.5.0" />
    <PackageReference Include="HotChocolate.Language" Version="16.5.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Snappier" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.3" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.2.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FactoryApp.Domain\FactoryApp.Domain.csproj" />
    <ProjectReference Include="..\FactoryApp.GraphQL\FactoryApp.GraphQL.csproj" />
    <ProjectReference Include="..\FactoryApp.Workflows\FactoryApp.Workflows.csproj" />
  </ItemGroup>

</Project>
