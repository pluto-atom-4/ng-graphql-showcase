<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- GitHub Packages - Elsa Workflows v3.6+ -->
    <add key="github" value="https://nuget.pkg.github.com/elsa-workflows/index.json" />
    <!-- Official NuGet source -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceCredentials>
    <github>
      <!-- GitHub token required for authentication -->
      <!-- Set via environment or dotnet nuget add source command -->
      <add key="Username" value="USERNAME_PLACEHOLDER" />
      <add key="ClearTextPassword" value="GITHUB_TOKEN_PLACEHOLDER" />
    </github>
  </packageSourceCredentials>
</configuration>
